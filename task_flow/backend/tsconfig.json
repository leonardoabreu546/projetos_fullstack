{
  "compilerOptions": {
    // Definir ambiente NodeNext / ES Modules
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Ficheiros de Saída
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,

    // Verificação de Tipos
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    
    // Desativado para permitir imports normais de CommonJS/ESM
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"]
}